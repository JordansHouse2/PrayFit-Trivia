# Optional — the app works fully offline/local without these (streak and
# Bible progress just live on-device only). Fill these in to turn on
# accounts + cross-device sync. See docs/supabase-setup.md for the full,
# step-by-step setup (create the project, run the migration, find these
# two values) — it takes about 10 minutes and doesn't require touching code.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
